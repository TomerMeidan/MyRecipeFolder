# Supabase — cloud database and authentication.
# Get both from your Supabase project: Settings → API.
# These ARE shipped to the browser/app (EXPO_PUBLIC_*). That is safe only because
# every table has Row Level Security — see scripts/supabase-schema.sql.
# Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google AI Studio key for recipe scanning. SERVER-SIDE ONLY: read by api/parse-recipe.ts
# on Vercel. Never prefix it with EXPO_PUBLIC_ — that would bake it into the client bundle.
GEMINI_API_KEY=your_gemini_api_key_here

# Native (iOS/Android) builds only: the deployed origin hosting /api/parse-recipe,
# e.g. https://myrecipefolder.vercel.app. Web uses same-origin and can leave this unset.
# For local web dev, run `vercel dev` or point this at the deployed site.
EXPO_PUBLIC_API_BASE_URL=
